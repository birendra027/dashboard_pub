# Template only. On first run, prepare.cjs copies this to server/.env and
# fills the two secrets below with values unique to this machine.
# The authentication connector settings are compiled into the app, not here.
DATABASE_URL="file:./dev.db"
JWT_SECRET="__GENERATED_ON_FIRST_RUN_JWT__"
PORT=4000
# 32-byte hex key for field-level AES-256-GCM encryption at rest.
DATA_ENCRYPTION_KEY="__GENERATED_ON_FIRST_RUN_KEY__"

# The static client host reads this to serve the SPA and proxy the API.
CLIENT_PORT=3000
