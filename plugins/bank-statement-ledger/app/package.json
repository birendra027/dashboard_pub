{
  "name": "statement-ledger",
  "version": "1.0.0",
  "private": true,
  "description": "Statement Ledger — turns bank statement PDFs into a categorised T-format ledger with Excel export.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/build.js",
    "start": "node dist/server.js",
    "verify": "tsx src/tools/verify.ts",
    "counterparties": "tsx src/tools/counterparties.ts",
    "detect": "tsx src/tools/detect.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts public/app.js",
    "test": "tsx --test src/**/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "javascript-obfuscator": "^4.1.1",
    "terser": "^5.37.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.24.2": true
  }
}
