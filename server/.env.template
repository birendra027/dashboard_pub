# Template only. On first run, prepare.cjs copies this to server/.env and
# fills the two secrets below with values unique to this machine.
DATABASE_URL="file:./dev.db"
JWT_SECRET="__GENERATED_ON_FIRST_RUN_JWT__"
PORT=4000
# 32-byte hex key for field-level AES-256-GCM encryption at rest.
DATA_ENCRYPTION_KEY="__GENERATED_ON_FIRST_RUN_KEY__"

# --- authentication connector ---
AUTH_SERVICE_URL="https://gej236glri.execute-api.ap-south-1.amazonaws.com"
AUTH_ISSUER="https://gej236glri.execute-api.ap-south-1.amazonaws.com"
AUTH_AUDIENCE="plugboard-dashboard"

# The static client host reads these to serve the SPA and proxy the API.
CLIENT_PORT=3000
